# Exact deployed origin with no trailing slash. Safe local development overrides this value.
NEXT_PUBLIC_SITE_URL=https://sellmykernhome.example
NEXT_PUBLIC_ROBOTS_INDEX=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY=
SMKH_ENVIRONMENT=local
SMKH_DEMO_MODE=false

# Private staging access. Configure only in the isolated staging context.
DEMO_ACCESS_USERNAME=
DEMO_ACCESS_PASSWORD=
DEMO_SESSION_SECRET=
SMKH_ENABLE_STAGING_ANALYTICS=false
SMKH_ENABLE_STAGING_EMAIL=false

# Supabase managed auth, database, and object storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Isolated Adam demonstration project. These must never equal production values.
STAGING_SUPABASE_URL=
STAGING_SUPABASE_PUBLISHABLE_KEY=
STAGING_SUPABASE_SECRET_KEY=
STAGING_RATE_LIMIT_HMAC_SECRET=

# Email delivery (Resend)
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
EMAIL_FROM=Sell My Kern Home <notifications@example.com>
EMAIL_REPLY_TO=

# Staging email remains disabled until separately authorized.
STAGING_RESEND_API_KEY=
STAGING_LEAD_NOTIFICATION_EMAIL=
STAGING_EMAIL_FROM=
STAGING_EMAIL_REPLY_TO=
STAGING_ADMIN_BASE_URL=

# GNZ admin destination used in internal notification links
GNZ_ADMIN_BASE_URL=

# Cloudflare Turnstile (required for production submissions)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_STAGING_TURNSTILE_SITE_KEY=
STAGING_TURNSTILE_SECRET_KEY=

# Generate a unique high-entropy value for production
RATE_LIMIT_HMAC_SECRET=

# Optional: read-only integration verification of existing admin accounts.
# Do not configure these in the deployed public-site environment.
ADMIN=
ADMIN_PW=
ADMIN2=
ADMIN2_PW=

# Exact deployed origin with no trailing slash. Safe local development overrides this value.
NEXT_PUBLIC_SITE_URL=https://sellmykernhome.example
NEXT_PUBLIC_ROBOTS_INDEX=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY=

# Supabase managed auth, database, and object storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Email delivery (Resend)
RESEND_API_KEY=
SMKH_NOTIFICATIONS_ENABLED=false
LEAD_NOTIFICATION_EMAIL=
EMAIL_FROM=Sell My Kern Home <notifications@example.com>
EMAIL_REPLY_TO=
SMKH_ADMIN_BASE_URL=https://sellmykernhome.com

# Cloudflare Turnstile (required for production submissions)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Generate a unique high-entropy value for production
RATE_LIMIT_HMAC_SECRET=

# Partner delivery is intentionally disabled until named recipients, contracts,
# and operational authorization exist. Recipient format is a JSON array of
# objects with stable id and public name fields.
SMKH_PARTNER_DELIVERY_ENABLED=false
SMKH_APPROVED_SHARING_RECIPIENTS=[]

# Optional: read-only integration verification of existing admin accounts.
# Do not configure these in the deployed public-site environment.
ADMIN=
ADMIN_PW=
ADMIN2=
ADMIN2_PW=
